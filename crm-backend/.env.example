# ---- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=0

# ---- MongoDB Atlas Database -----------------------------------------------
# MongoDB connection string.
# For MongoDB Atlas:
# 1. Go to MongoDB Atlas (https://cloud.mongodb.com)
# 2. In Database Deployments, click "Connect"
# 3. Choose "Drivers" (Node.js)
# 4. Copy connection string and replace <username> and <password>
# Example:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/advisory_crm?retryWrites=true&w=majority

# ---- JWT Authentication ----------------------------------------------------
# Secret key used for signing advisor session tokens (minimum 10 characters)
JWT_SECRET=change-me-to-a-long-random-string

# ---- Optional Webhooks ----------------------------------------------------
# Shared secret for POST /api/webhooks/leads (header X-Webhook-Secret or ?token=)
LEAD_WEBHOOK_SECRET=
# Inbound SMS webhook secrets (Twilio or custom provider)
SMS_WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=
